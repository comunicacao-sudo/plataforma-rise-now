# Public browser configuration. Keep real values in Lovable Cloud or your local .env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SUPABASE_PROJECT_ID=replace_me

# Server-only configuration. Never prefix the service role key with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_PROJECT_ID=replace_me
SUPABASE_SERVICE_ROLE_KEY=configure_only_in_server_environment

# Transactional WhatsApp via a private WAHA Core/GOWS instance.
# These values are server-only. Never prefix them with VITE_.
APP_BASE_URL=https://mentoriarisenow.lovable.app
WAHA_BASE_URL=https://whatsapp.internal.example.com
WAHA_API_KEY=configure_only_in_server_environment
WAHA_SESSION_NAME=rise-principal
WAHA_WEBHOOK_HMAC_KEY=configure_only_in_server_environment

# Protects POST /api/cron/whatsapp. Configure the same bearer token in the scheduler.
LOVABLE_CRON_SECRET=configure_only_in_server_environment
