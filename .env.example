# Official Supabase project: riakceytqrlvdcgcwfdx
#
# The browser configuration is deliberately pinned in vite.config.ts. Do not
# add VITE_SUPABASE_* variables here; generated .env files are not trusted.
#
# Optional server-only connection used by local migration tooling. The project
# guard in drizzle.config.ts rejects URLs for every other Supabase project.
SUPABASE_DB_URL=

# Edge Function secrets belong only in Supabase Edge Functions > Secrets.
# Keep these names documented here, but never put their values in repository files.
# APP_BASE_URL=
# WAHA_BASE_URL=
# WAHA_API_KEY=
# WAHA_SESSION_NAME=
# WAHA_WEBHOOK_HMAC_KEY=
# CRON_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_STATE_SECRET=
# APP_USER_CONNECTION_KEY_SECRET=

