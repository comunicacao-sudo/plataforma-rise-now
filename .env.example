# Public browser configuration. These are the only values exposed to the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SUPABASE_PROJECT_ID=replace_me

# Supabase Edge Function secrets (configure in Edge Functions > Secrets).
# Supabase injects its project URL and secret keys automatically.
APP_BASE_URL=https://mentoriarisenow.lovable.app
WAHA_BASE_URL=https://whatsapp.internal.example.com
WAHA_API_KEY=configure_only_in_supabase
WAHA_SESSION_NAME=rise-principal
WAHA_WEBHOOK_HMAC_KEY=configure_only_in_supabase
CRON_SECRET=configure_only_in_supabase
GOOGLE_CLIENT_ID=configure_only_in_supabase
GOOGLE_CLIENT_SECRET=configure_only_in_supabase
GOOGLE_OAUTH_STATE_SECRET=configure_only_in_supabase
APP_USER_CONNECTION_KEY_SECRET=base64_encoded_32_byte_key
