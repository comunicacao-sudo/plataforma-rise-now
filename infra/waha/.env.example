# The WAHA container stores only the SHA-512 hash. Keep the corresponding plain
# API key in the application secret manager as WAHA_API_KEY; never commit it.
WAHA_API_KEY_HASH=sha512:REPLACE_WITH_SHA512_HEX_HASH

# Protect the operational dashboard and Swagger independently.
WAHA_DASHBOARD_USERNAME=replace-with-admin-user
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-password
WHATSAPP_SWAGGER_USERNAME=replace-with-admin-user
WHATSAPP_SWAGGER_PASSWORD=replace-with-a-long-random-password

# Local host port. Docker binds it only to 127.0.0.1.
WAHA_PORT=3000

# Public HTTPS address served by the hardened reverse proxy, without a trailing slash.
WAHA_PUBLIC_URL=https://whatsapp.example.com

# WAHA sends only message acknowledgement events to this authenticated endpoint.
RISE_WEBHOOK_URL=https://mentoriarisenow.lovable.app/api/webhooks/waha
WAHA_WEBHOOK_HMAC_KEY=replace-with-a-long-random-shared-secret
